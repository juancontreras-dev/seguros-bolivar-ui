{
  "name": "@seguros-bolivar/ui-bundle",
  "version": "1.0.0",
  "description": "Seguros Bolivar UI Design System - Multi-brand CSS & Web Components Bundle for CDN",
  "type": "module",
  "private": false,
  "main": "./dist/sb-ui-seguros-bolivar-light.min.css",
  "types": "./dist/types/index.d.ts",
  "files": [
    "dist/**/*.css",
    "dist/**/*.js",
    "dist/**/*.map",
    "dist/**/*.gz",
    "dist/**/*.br",
    "dist/fonts/**/*.woff2",
    "dist/webfonts/**/*",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsx src/builder.ts",
    "dev": "tsx watch src/builder.ts",
    "clean": "node -e \"require('fs').rmSync('dist', {recursive:true, force:true})\"",
    "serve": "npx serve dist -p 3000",
    "prepublishOnly": "pnpm run clean && pnpm run build",
    "publish:dry": "npm publish --dry-run",
    "publish:public": "npm publish --access public"
  },
  "keywords": [
    "design-system",
    "seguros-bolivar",
    "multi-brand",
    "css",
    "web-components",
    "ui-components",
    "cdn",
    "bundle",
    "lit",
    "atomic-design",
    "design-tokens",
    "responsive",
    "accessibility",
    "dark-mode",
    "colombia"
  ],
  "homepage": "https://github.com/segurosbolivar/seguros-bolivar-ui-lib#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/segurosbolivar/seguros-bolivar-ui-lib.git",
    "directory": "packages/bundle"
  },
  "bugs": {
    "url": "https://github.com/segurosbolivar/seguros-bolivar-ui-lib/issues"
  },
  "author": {
    "name": "Seguros Bolivar UI Team",
    "email": "ui-team@segurosbolivar.com",
    "url": "https://www.segurosbolivar.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@seguros-bolivar-ui/atoms": "workspace:*",
    "@seguros-bolivar-ui/molecules": "workspace:*",
    "@seguros-bolivar-ui/tokens": "workspace:*",
    "@types/node": "^20.11.19",
    "clean-css": "^5.3.3",
    "compression": "^1.8.1",
    "cssnano": "^7.1.1",
    "esbuild": "^0.20.1",
    "postcss": "^8.5.6",
    "postcss-import": "^16.1.1",
    "postcss-nesting": "^13.0.2",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3",
    "@fortawesome/fontawesome-free": "^6.5.1"
  }
}