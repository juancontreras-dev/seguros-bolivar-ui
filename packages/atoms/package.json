{
  "name": "@seguros-bolivar-ui/atoms",
  "version": "1.0.0",
  "description": "Componentes CSS simples para Seguros Bolivar UI Design System",
  "main": "dist/index.css",
  "files": [
    "dist/**/*"
  ],
  "exports": {
    ".": "./dist/index.css",
    "./button.css": "./dist/button.css",
    "./input.css": "./dist/input.css",
    "./textArea.css": "./dist/textArea.css",
    "./select.css": "./dist/select.css",
    "./toggle.css": "./dist/toggle.css",
    "./alert.css": "./dist/alert.css",
    "./checkbox.css": "./dist/checkbox.css",
    "./radio.css": "./dist/radio.css",
    "./badge.css": "./dist/badge.css",
    "./card.css": "./dist/card.css",
    "./container.css": "./dist/container.css",
    "./grid.css": "./dist/grid.css",
    "./columns.css": "./dist/columns.css",
    "./gutters.css": "./dist/gutters.css",
    "./css-grid.css": "./dist/css-grid.css"
  },
  "scripts": {
    "build": "npm run clean && npm run build:copy && npm run build:bundle",
    "clean": "node -e \"require('fs').rmSync('dist', {recursive:true, force:true})\"",
    "build:copy": "node -e \"require('fs').mkdirSync('dist', {recursive:true}); require('fs').cpSync('src', 'dist', {recursive:true})\"",
    "build:bundle": "node -e \"const fs=require('fs'); const files=['container','grid','columns','gutters','css-grid','button','input','textArea','select','calendar','spinner','toggle','alert','checkbox','radio','tabs','stepper'].map(f=>'src/'+f+'.css'); const content=files.map(f=>fs.existsSync(f)?fs.readFileSync(f,'utf8'):'').join('\\n'); fs.writeFileSync('dist/index.css',content)\"",
    "dev": "npm run build",
    "lint": "stylelint 'src/**/*.css'"
  },
  "keywords": [
    "css",
    "components",
    "atoms",
    "design-system",
    "button",
    "input",
    "textarea",
    "select",
    "toggle",
    "alert",
    "checkbox",
    "radio",
    "badge",
    "card",
    "container",
    "grid",
    "columns",
    "gutters",
    "layout"
  ],
  "author": "Seguros Bolivar UI",
  "license": "MIT",
  "devDependencies": {
    "stylelint": "^16.2.1",
    "stylelint-config-standard": "^36.0.0"
  }
}
