{
  "name": "@seguros-bolivar-ui/atoms",
  "version": "1.0.0",
  "description": "Componentes CSS simples para Seguros Bolivar UI Design System",
  "main": "dist/index.css",
  "files": [
    "dist/**/*"
  ],
  "exports": {
    ".": "./dist/index.css",
    "./accordion.css": "./dist/accordion.css",
    "./alert.css": "./dist/alert.css",
    "./avatar.css": "./dist/avatar.css",
    "./badge.css": "./dist/badge.css",
    "./breadcrumb.css": "./dist/breadcrumb.css",
    "./button.css": "./dist/button.css",
    "./calendar.css": "./dist/calendar.css",
    "./checkbox.css": "./dist/checkbox.css",
    "./chip.css": "./dist/chip.css",
    "./columns.css": "./dist/columns.css",
    "./container.css": "./dist/container.css",
    "./css-grid.css": "./dist/css-grid.css",
    "./file-upload.css": "./dist/file-upload.css",
    "./grid.css": "./dist/grid.css",
    "./gutters.css": "./dist/gutters.css",
    "./input.css": "./dist/input.css",
    "./menu.css": "./dist/menu.css",
    "./radio.css": "./dist/radio.css",
    "./select.css": "./dist/select.css",
    "./slider.css": "./dist/slider.css",
    "./spinner.css": "./dist/spinner.css",
    "./stepper.css": "./dist/stepper.css",
    "./table.css": "./dist/table.css",
    "./tabs.css": "./dist/tabs.css",
    "./textArea.css": "./dist/textArea.css",
    "./toggle.css": "./dist/toggle.css"
  },
  "scripts": {
    "build": "npm run clean && npm run build:copy && npm run build:bundle",
    "clean": "node -e \"require('fs').rmSync('dist', {recursive:true, force:true})\"",
    "build:copy": "node -e \"require('fs').mkdirSync('dist', {recursive:true}); require('fs').cpSync('src', 'dist', {recursive:true})\"",
    "build:bundle": "node -e \"const fs=require('fs'); const files=['accordion','alert','avatar','badge','breadcrumb','button','calendar','checkbox','chip','container','grid','columns','gutters','css-grid','file-upload','input','menu','radio','select','slider','spinner','stepper','table','tabs','textArea','toggle'].map(f=>'src/'+f+'.css'); const content=files.map(f=>fs.existsSync(f)?fs.readFileSync(f,'utf8'):'').join('\\n'); fs.writeFileSync('dist/index.css',content)\"",
    "dev": "npm run build",
    "lint": "stylelint 'src/**/*.css'"
  },
  "keywords": [
    "css",
    "components",
    "atoms",
    "design-system",
    "accordion",
    "alert",
    "avatar",
    "badge",
    "breadcrumb",
    "button",
    "calendar",
    "checkbox",
    "chip",
    "file-upload",
    "input",
    "radio",
    "select",
    "slider",
    "spinner",
    "stepper",
    "table",
    "tabs",
    "textarea",
    "toggle",
    "container",
    "grid",
    "columns",
    "gutters",
    "layout"
  ],
  "author": "Seguros Bolivar UI",
  "license": "MIT",
  "devDependencies": {
    "stylelint": "^16.2.1",
    "stylelint-config-standard": "^36.0.0"
  }
}
