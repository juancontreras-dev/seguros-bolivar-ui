--sb-ui-tabs-description-color: var(--sb-ui-color-grayscale-D100); /* #757575 */

/* Hover & Active - Los textos e iconos mantienen su color verde corporativo */
--sb-ui-tabs-bg-hover: var(--sb-ui-color-secondary-L100); /* #FFEA9A */
--sb-ui-tabs-bg-active: var(--sb-ui-color-secondary-L100); /* #FFEA9A */
