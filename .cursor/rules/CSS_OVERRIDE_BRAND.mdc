<!-- Aplicar brand mediante data-brand -->
<div data-brand="seguros-bolivar">
  <!-- Todos los componentes dentro heredan el override -->
  <button class="sb-ui-button- sb-ui-button--primary">
    Primary Stroke (override Seguros Bolívar)
