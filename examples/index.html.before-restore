    <script>
      const contentInner = document.querySelector('.content-inner');
      const sidebar = document.getElementById('sidebar');
      const hamburger = document.getElementById('hamburger');

      // ========================================
      // DYNAMIC CONTENT LOADING
      // ========================================
      function loadContent(path) {
        // Show loading state
        contentInner.innerHTML = '<div style="padding: 2rem; text-align: center;"><i class="fas fa-spinner" style="font-size: 2rem; animation: spin 1s linear infinite;"></i><p>Cargando...</p></div>';
        
        // Fetch the HTML file
        fetch(path)
          .then(response => {
            if (!response.ok) throw new Error('Error loading page');
            return response.text();
          })
          .then(html => {
            // Parse the HTML
            const parser = new DOMParser();
            const doc = parser.parseFromString(html, 'text/html');
            
            // Get the main content (adjust selector based on structure)
            let content = doc.querySelector('.content-inner');
            if (!content) {
              content = doc.querySelector('main');
            }
            if (!content) {
              content = doc.body;
            }
            
            // Insert the content
            contentInner.innerHTML = content.innerHTML;
            
            // Re-initialize any scripts or styles if needed
            initializeLoadedContent();
            
            // Close sidebar on mobile
            if (window.innerWidth <= 768) {
              sidebar.classList.remove('open');
            }
          })
          .catch(error => {
            console.error('Error loading content:', error);
            contentInner.innerHTML = '<div style="padding: 2rem; text-align: center; color: red;"><i class="fas fa-exclamation-circle"></i><p>Error al cargar la página</p></div>';
          });
      }

      // Function to reinitialize content after loading
      function initializeLoadedContent() {
        // You can add any initialization code here for loaded content
        // For example, reinitialize event listeners, animations, etc.
      }

      // ========================================
      // SIDEBAR NAVIGATION
      // ========================================
      // Get all navigation items (buttons with data-path)
      const navButtons = document.querySelectorAll('[data-path]');
      
      navButtons.forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          const path = btn.getAttribute('data-path');
          
          // Remove active class from all nav items
          navButtons.forEach(b => b.classList.remove('active'));
          
          // Add active class to clicked button
          btn.classList.add('active');
          
          // Load the content
          loadContent(path);
        });
      });

      // Sidebar toggle functionality
      hamburger.addEventListener('click', () => {
        sidebar.classList.toggle('open');
      });

      // Close sidebar when clicking outside on mobile
      document.addEventListener('click', (e) => {
        const isMobile = window.innerWidth <= 768;
        if (isMobile && !sidebar.contains(e.target) && !hamburger.contains(e.target)) {
          sidebar.classList.remove('open');
        }
      });

      // ========================================
      // SUBMENU FUNCTIONALITY
      // ========================================
      const submenuButtons = document.querySelectorAll('.sidebar-submenu-btn');
      
      submenuButtons.forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          const submenuId = btn.getAttribute('data-submenu');
          const submenu = document.getElementById(submenuId);
          const toggle = btn.querySelector('.sidebar-submenu-toggle');
          
          // Close other open submenus
          document.querySelectorAll('.sidebar-submenu').forEach(m => {
            if (m.id !== submenuId) {
              m.classList.remove('open');
            }
          });
          
          document.querySelectorAll('.sidebar-submenu-toggle').forEach(t => {
            if (t !== toggle) {
              t.classList.remove('open');
            }
          });
          
          // Toggle current submenu
          submenu.classList.toggle('open');
          toggle.classList.toggle('open');
        });
      });

      // Initialize: load default content (Inicio)
      const inicioBtn = document.querySelector('[data-path="index.html"]');
      if (inicioBtn) {
        inicioBtn.classList.add('active');
      }

      // CSS animation for loading spinner
      const style = document.createElement('style');
      style.textContent = `
        @keyframes spin {
          0% { transform: rotate(0deg); }
          100% { transform: rotate(360deg); }
        }
      `;
      document.head.appendChild(style);
    </script>
